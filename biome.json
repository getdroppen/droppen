{
  "$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
  "formatter": {
    "enabled": false
  },
  "assist": {
    "enabled": false
  },
  "files": {
    "ignoreUnknown": true,
    "includes": [
      "web/src/**",
      "!web/src/api/schema.d.ts",
      "!web/src/api/hub-schema.d.ts",
      "!web/dist"
    ]
  },
  "css": {
    "parser": {
      "tailwindDirectives": true
    }
  },
  "linter": {
    "enabled": true,
    "domains": {
      "react": "recommended"
    },
    "rules": {
      "preset": "none",
      "correctness": {
        "preset": "recommended",
        "noVoidTypeReturn": "off",
        "useExhaustiveDependencies": "off"
      },
      "suspicious": {
        "preset": "recommended",
        "noArrayIndexKey": "off",
        "noAssignInExpressions": "off",
        "noConfusingVoidType": "off",
        "noControlCharactersInRegex": "off",
        "noImplicitAnyLet": "off",
        "noTemplateCurlyInString": "off",
        "useIterableCallbackReturn": {
          "level": "error",
          "options": {
            "checkForEach": false
          }
        }
      },
      "security": {
        "preset": "recommended"
      }
    }
  },
  "overrides": [
    {
      "includes": ["web/src/lib/hub/account.ts"],
      "linter": {
        "rules": {
          "correctness": {
            "noUnusedImports": "off"
          }
        }
      }
    }
  ]
}
