{
  "$comment": "The machine-readable index of the v1 hub API (docs/hub-api/README.md). check.mjs requires every route and every control message `t` the open clients use to be listed here, every listed route and message to have a schema, and captured traffic to match. Paths are templates: `{x}` is one segment, `{*x}` one or more. auth: none | session (a login or a device session) | device (a device session) | admin (Bearer DROPPEN_HUB_ADMIN_TOKEN). `requires`: where the device must stand in the account's chain (full: a current full device; current: any current device). channels: c2s is client to server (device, agent, relay or the app to the hub, a relay or the Turnstile page), s2c the other way.",
  "version": "v1",
  "routes": [
    { "server": "hub", "method": "GET", "path": "/healthz", "auth": "none", "response": "text" },
    { "server": "hub", "method": "GET", "path": "/install.sh", "auth": "none", "response": "none", "audience": "tooling", "redirect": "https://github.com/getdroppen/droppen/releases/latest/download/install.sh" },
    { "server": "hub", "method": "GET", "path": "/turnstile", "auth": "none", "response": "html", "host": "turnstile" },
    { "server": "hub", "method": "GET", "path": "/.well-known/droppen-build", "auth": "none", "audience": "tooling", "optional": "DROPPEN_HUB_WEB_DIR" },
