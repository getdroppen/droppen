    { "server": "hub", "method": "GET", "path": "/v1/admin/waitlist", "auth": "admin", "audience": "operator" },
    { "server": "hub", "method": "DELETE", "path": "/v1/admin/waitlist/{email}", "auth": "admin", "audience": "operator" },
