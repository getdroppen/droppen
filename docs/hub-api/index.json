    { "server": "hub", "method": "POST", "path": "/v1/waitlist", "auth": "none" },
    { "server": "hub", "method": "GET", "path": "/v1/client", "auth": "none", "websocket": "/v1/client" },
    { "server": "hub", "method": "GET", "path": "/v1/agent", "auth": "none", "websocket": "/v1/agent" },
    { "server": "hub", "method": "GET", "path": "/v1/relay", "auth": "none", "websocket": "/v1/relay", "audience": "relay" },
    { "server": "hub", "method": "GET", "path": "/v1/probe/rooms/{room}", "auth": "none", "websocket": "probe", "audience": "tooling", "optional": "DROPPEN_HUB_P2P_PROBE=1" },
    { "server": "hub", "method": "POST", "path": "/v1/admin/invites", "auth": "admin", "audience": "operator" },
    { "server": "hub", "method": "GET", "path": "/v1/admin/accounts/{who}", "auth": "admin", "audience": "operator" },
    { "server": "hub", "method": "PUT", "path": "/v1/admin/accounts/{who}/plan", "auth": "admin", "audience": "operator" },
    { "server": "hub", "method": "PUT", "path": "/v1/admin/accounts/{who}/overrides/{key}", "auth": "admin", "audience": "operator" },
