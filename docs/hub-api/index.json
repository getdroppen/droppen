    { "server": "hub", "method": "GET", "path": "/v1/rotations", "auth": "device" },
    { "server": "hub", "method": "PUT", "path": "/v1/rotations/{host}", "auth": "device", "requires": "full" },
    { "server": "hub", "method": "DELETE", "path": "/v1/rotations/{host}", "auth": "device", "requires": "full" },
    { "server": "hub", "method": "POST", "path": "/v1/rotations/{host}/disputes", "auth": "none" },
    { "server": "hub", "method": "GET", "path": "/v1/passkeys", "auth": "device", "requires": "current" },
    { "server": "hub", "method": "POST", "path": "/v1/passkeys/add/options", "auth": "device", "requires": "full" },
    { "server": "hub", "method": "POST", "path": "/v1/passkeys", "auth": "device", "requires": "full" },
    { "server": "hub", "method": "POST", "path": "/v1/passkeys/reauth/options", "auth": "device", "requires": "full" },
    { "server": "hub", "method": "PATCH", "path": "/v1/passkeys/{id}", "auth": "device", "requires": "full" },
    { "server": "hub", "method": "DELETE", "path": "/v1/passkeys/{id}", "auth": "device", "requires": "full" },
    { "server": "hub", "method": "PUT", "path": "/v1/password", "auth": "device", "requires": "full" },
    { "server": "hub", "method": "DELETE", "path": "/v1/password", "auth": "device", "requires": "full" },
    { "server": "hub", "method": "DELETE", "path": "/v1/account", "auth": "device", "requires": "full" },

    { "server": "relay", "method": "GET", "path": "/healthz", "auth": "none", "response": "text" },
    { "server": "relay", "method": "GET", "path": "/v1/ping", "auth": "none", "response": "none" },
    { "server": "relay", "method": "GET", "path": "/v1/relay-id", "auth": "none", "audience": "hub" },
    { "server": "relay", "method": "GET", "path": "/v1/connect", "auth": "none", "websocket": "/v1/connect" }
  ],
  "channels": {
    "/v1/client": {
      "server": "hub",
      "kind": "websocket",
      "c2s": ["login", "chain_sub", "stream_unsub"],
      "s2c": ["challenge", "welcome", "presence", "plan", "mail", "chain_result", "error", "stream_synced", "stream_refused", "device_registered", "main_device", "sign_in_changed", "rotation", "host_dispute"]
    },
    "/v1/agent": {
      "server": "hub",
      "kind": "websocket",
      "c2s": ["login", "enroll", "enroll_proof", "chain_sub", "mail_ack", "mail_release", "agent_info", "relay_tickets", "relay_state", "stream_list", "stream_delete", "rotation_stage", "rotation_ack", "rotation_unknown"],
      "s2c": ["challenge", "welcome", "enroll_assigned", "mail", "error", "plan", "stream_refused", "stream_watched", "stream_list", "relay_set", "relay_tickets", "rotation_staged", "rotation_refused", "rotation_pending"]
    },
    "/v1/relay": {
      "server": "hub",
      "kind": "websocket",
      "c2s": ["login", "register", "health", "usage", "meta", "draining", "deregister", "rotate"],
      "s2c": ["challenge", "welcome", "registered", "error", "usage_ok", "deregistered", "rotated", "revoke", "replayed", "throttle", "throttles", "keys", "drain"],
      "reserved": ["keys", "drain"]
    },
    "/v1/connect": {
      "server": "relay",
      "kind": "websocket",
      "c2s": ["login", "ticket"],
      "s2c": ["challenge", "welcome", "presence", "ticket_ok", "goaway", "error"]
    },
    "/turnstile": {
      "server": "hub",
      "kind": "postMessage",
      "c2s": ["turnstile-reset"],
      "s2c": ["turnstile"]
    }
  }
}
