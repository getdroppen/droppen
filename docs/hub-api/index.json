    { "server": "hub", "method": "POST", "path": "/v1/login", "auth": "none" },
    { "server": "hub", "method": "POST", "path": "/v1/passkeys/options", "auth": "none" },
    { "server": "hub", "method": "POST", "path": "/v1/signup/passkey", "auth": "none" },
