    { "server": "hub", "method": "PUT", "path": "/v1/admin/accounts/{who}/suspension", "auth": "admin", "audience": "operator" },
    { "server": "hub", "method": "DELETE", "path": "/v1/admin/accounts/{who}/suspension", "auth": "admin", "audience": "operator" },
    { "server": "hub", "method": "DELETE", "path": "/v1/admin/accounts/{who}", "auth": "admin", "audience": "operator" },
    { "server": "hub", "method": "GET", "path": "/v1/admin/relays", "auth": "admin", "audience": "operator" },
