{
  "name": "@remote-hand/web",
  "private": true,
  "version": "0.1.0",
  "license": "AGPL-3.0-only",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "gen:api": "openapi-typescript ../openapi/openapi.json -o src/api/schema.d.ts",
    "gen:pwa": "node scripts/gen-pwa-assets.mjs",
    "test": "tsx --test test/*.test.ts test/*.test.tsx",
    "test:shard": "tsx --test --test-shard=\"${TEST_SHARD:?set TEST_SHARD=<index>/<total>, e.g. 1/3}\" test/*.test.ts test/*.test.tsx",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@base-ui-components/react": "^1.0.0-beta.1",
    "@droppen/plugin-sdk": "workspace:*",
    "@noble/curves": "2.4.0",
    "@tanstack/react-query": "^5.66.0",
    "@tanstack/react-router": "^1.112.0",
    "@tanstack/react-virtual": "^3.14.6",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-webgl": "0.19.0",
    "@xterm/xterm": "^6.0.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "i18next": "^26.3.6",
    "jsqr": "^1.4.0",
    "lucide-react": "^0.475.0",
    "openapi-fetch": "^0.13.4",
    "qrcode-generator": "^2.0.4",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-i18next": "^17.0.10",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "tailwind-merge": "^3.0.0"
  },
  "devDependencies": {
    "@resvg/resvg-js": "^2.6.2",
    "@tailwindcss/vite": "^4.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "jsdom": "^30.1.3",
    "openapi-typescript": "^7.6.0",
    "tailwindcss": "^4.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.8.0",
    "vite": "^6.4.4"
  }
}
